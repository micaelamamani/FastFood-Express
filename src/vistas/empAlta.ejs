<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comida Rapida</title>
    <link rel="stylesheet" href="/estilo/estilo.css">
</head>
<body>
    <header>
            <section id="imagen">
                <img src="../img/logoComidaRapida.svg" alt="logo">
                <h2>FastFood Express</h2>
            </section>
            <section id="menu">
                <nav>
                    <ul>
                        <li id="boton"><a href='/'>Home</a></li>
                        <li id="boton"><a href='/cliente'>clientes</a></li>
                        <li id="boton"  style="background-color: black"><a href="/empleado">empleados</a></li>
                        <li id="boton"><a href="/producto">productos</a></li>
                        <li id="boton"><a href="/pedido">pedidos</a></li>
                        <li id="boton"><a href="/detalle">detalles de pedidos</a></li>
                        <li id="boton"><a href="estadistica.ejs">estadistica</a></li>
                    </ul>
                </nav>
            </section>
        </header>
     <h1>Formulario de Empleado</h1>
    <form id="formu" action="/empleado/empNuevo" method="post" autocomplete="off">
        <div id="estiloForm">
            <label for="id">ID:</label>
            <input type="text" id="idempleado" name="idhtml" required>

            <label for="nombre">Nombre:</label>
            <input type="text" id="nombreEmpleado" name="nomhtml" required>

            <label for="cargo">Cargo:</label>
            <input type="text" id="cargo" name="cargohtml" required>

            <label for="turno">Turno:</label>
            <input type="text" id="turno" name="turnohtml">
        </div>
         <input class="btnEnviar" type="submit" value="Enviar">
    </form>
</body>
</html>