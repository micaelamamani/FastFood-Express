<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comida Rapida</title>
    <link rel="stylesheet" href="/estilo/estilo.css">
</head>

<body>
    <header>
        <section id="imagen">
            <img src="../img/logoComidaRapida.svg" alt="logo">
            <h2>FastFood Express</h2>
        </section>
        <section id="menu">
            <nav>
                <ul>
                    <li id="boton"><a href='/'>Home</a></li>
                    <li id="boton" style="background-color: black"><a href='/cliente'>clientes</a></li>
                    <li id="boton"><a href="/empleado">empleados</a></li>
                    <li id="boton"><a href="/producto">productos</a></li>
                    <li id="boton"><a href="/pedido">pedidos</a></li>
                    <li id="boton"><a href="/estadistica">estadistica</a></li>
                </ul>
            </nav>
        </section>
    </header>
    <h1>Formulario de Cliente</h1>
    <form id="formu" action="/cliente/cliNuevo" method="post">
        <div id="estiloForm">
            <label for="id">ID:</label>
            <input type="text" id="idcliente" name="idhtml" required>

            <label for="nombre">Nombre:</label>
            <input type="text" id="nombreCliente" name="nomhtml" required>

            <label for="direccion">Dirección:</label>
            <input type="text" id="direccion" name="dirhtml" required>

            <label for="telefono">Teléfono:</label>
            <input type="tel" id="telefono" name="telhtml">
        </div>
        <input class="btnEnviar" type="submit" value="Enviar">
    </form>
</body>

</html>