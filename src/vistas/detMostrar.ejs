<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilo/estilo.css">
    <title>Mostrar clientes</title>
</head>
<body>
    <header>
            <section id="imagen">
                <img src="../img/logoComidaRapida.svg" alt="logo">
                <h2>FastFood Express</h2>
            </section>
            <section id="menu">
                <nav>
                    <ul>
                        <li id="boton"><a href='/'>Home</a></li>
                        <li id="boton"><a href='/cliente'>clientes</a></li>
                        <li id="boton"><a href="/empleado">empleados</a></li>
                        <li id="boton"><a href="/producto">productos</a></li>
                        <li id="boton"><a href="/pedido">pedidos</a></li>
                        <li id="boton"  style="background-color: black"><a href="/detalle">detalles de pedidos</a></li>
                        <li id="boton"><a href="/estadistica">estadistica</a></li>
                    </ul>
                </nav>
            </section>
        </header>
    <h1>mostrar todo</h1>
    <table>
        <thead>
            <th>id detalle</th>
            <th>cantidad</th>
            <th>precio total</th>
            <th>id pedido</th>
            <th>id producto</th>
        </thead>
         <tbody>

               <% if (registros.length > 0) {
                    registros.forEach(det => { %>
                        <tr>
                            <td><%= det.iddetalle_pedido %></td>
                            <td><%= det.cantidad %></td>
                            <td><%= det.precio_total %></td>
                            <td><%= det.pedidos_idpedido%></td>
                            <td><%= det.productos_idproductos%></td>
                        </tr>                        
                 <%   });
                } else { %>
                    <p>No hay detalles cargados.</p>                    
                <% } %>
        </tbody>
     </table>

</body>
</html>