<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilo/estilo.css">
    <title>Mostrar clientes</title>
</head>
<body>
    <h1>mostrar todo</h1>
    <table>
        <thead>
            <th>id detalle</th>
            <th>cantidad</th>
            <th>precio total</th>
            <th>id pedido</th>
            <th>id producto</th>
        </thead>
         <tbody>

               <% if (registros.length > 0) {
                    registros.forEach(det => { %>
                        <tr>
                            <td><%= det.iddetalle_pedido %></td>
                            <td><%= det.cantidad %></td>
                            <td><%= det.precio_total %></td>
                            <td><%= det.pedidos_idpedido%></td>
                            <td><%= det.productos_idproductos%></td>
                        </tr>                        
                 <%   });
                } else { %>
                    <p>No hay detalles cargados.</p>                    
                <% } %>
        </tbody>
     </table>

</body>
</html>