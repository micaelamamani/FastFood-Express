<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilo/estilo.css">
    <title>Mostrar productos</title>
</head>
<body>
    <header>
            <section id="imagen">
                <img src="../img/logoComidaRapida.svg" alt="logo">
                <h2>FastFood Express</h2>
            </section>
            <section id="menu">
                <nav>
                    <ul>
                        <li id="boton"><a href='/'>Home</a></li>
                        <li id="boton"><a href='/cliente'>clientes</a></li>
                        <li id="boton"><a href="/empleado">empleados</a></li>
                        <li id="boton" style="background-color: black"><a href="/producto">productos</a></li>
                        <li id="boton"><a href="/pedido">pedidos</a></li>
                        <li id="boton"><a href="/detalle">detalles de pedidos</a></li>
                        <li id="boton"><a href="/estadistica">estadistica</a></li>
                    </ul>
                </nav>
            </section>
        </header>
    <h1>Productos</h1>
    <table>
        <thead>
            <th>idProducto</th>
            <th>nombre articulo</th>
            <th>categoria</th>
            <th>precio</th>
        </thead>
         <tbody>

               <% if (registros.length > 0) {
                    registros.forEach(prod => { %>
                        <tr>
                            <td><%= prod.idproductos %></td>
                            <td><%= prod.nombre_articulo %></td>
                            <td><%= prod.categoria %></td>
                            <td><%= prod.precio %></td>
                        </tr>                        
                 <%   });
                } else { %>
                    <p>No hay productos cargados.</p>                    
                <% } %>
        </tbody>
     </table>

</body>
</html>