<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comida Rapida</title>
    <link rel="stylesheet" href="/estilo/estilo.css">
</head>
<body>
    <header>
            <section id="imagen">
                <img src="../img/logoComidaRapida.svg" alt="logo">
                <h2>FastFood Express</h2>
            </section>
            <section id="menu">
                <nav>
                    <ul>
                        <li id="boton"><a href='/'>Home</a></li>
                        <li id="boton"><a href='/cliente'>clientes</a></li>
                        <li id="boton"><a href="/empleado">empleados</a></li>
                        <li id="boton"><a href="/producto">productos</a></li>
                        <li id="boton" style="background-color: black"><a href="/pedido">pedidos</a></li>
                        <li id="boton"><a href="/estadistica">estadistica</a></li>
                    </ul>
                </nav>
            </section>
        </header>
     <h1>Formulario de Pedido</h1>
    <form id="formu" action="/pedido/pedNuevo" method="post">
        <div id="estiloForm">
            <label for="id">ID:</label>
            <input type="text" id="idpedido" name="idhtml" required>

            <label for="fecha">Fecha:</label>
            <input type="text" id="fecha" name="fechahtml" required>

            <label for="hora">Hora:</label>
            <input type="text" id="hora" name="horahtml" required>

            <label for="tipo_servicio">Tipo de servicio:</label>
            <input type="text" id="tipo_servicio" name="serviciohtml">

            <label for="estado">Estado:</label>
            <input type="text" id="estado" name="estadohtml">

            <label for="clientes_idclientes">Id del cliente:</label>
            <input type="text" id="clientes_idclientes" name="clihtml">

            <label for="empleados_idempleados">Id del empleado:</label>
            <input type="text" id="empleados_idempleados" name="emphtml">
        </div>
         <input class="btnEnviar" type="submit" value="Enviar">
    </form>
</body>
</html>