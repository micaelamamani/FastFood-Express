<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comida Rapida</title>
    <link rel="stylesheet" href="/estilo/estilo.css">
</head>
<body>
     <h1>Formulario de Detalles del Pedido</h1>
    <form id="formu" action="/detalle/detNuevo" method="post" autocomplete="off">
        <div id="estiloForm">
            <label for="id">ID:</label>
            <input type="text" id="iddetallepedido" name="idhtml" required>

            <label for="nombre">Cantidad:</label>
            <input type="text" id="cantidad" name="canthtml" required>

            <label for="">Precio total:</label>
            <input type="text" id="precioTotal" name="prechtml" required>

            <label for="pedido">ID del Pedido:</label>
            <input type="text" id="" name="idpedidohtml">

            <a href="/pedido/mt" class="btnVerMas" >Ver Mas</a>

             <label for="producto">ID del Producto:</label>
            <input type="text" id="" name="idproductohtml">

            <a href="/producto/mt" class="btnVerMas" >Ver Mas</a>

        </div>
         <input class="btnEnviar" type="submit" value="Enviar">
         <a href="/" class="btnCancelar" >Cancelar</a>
    </form>
</body>
</html>